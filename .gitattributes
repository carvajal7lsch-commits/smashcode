# Los scripts de shell SIEMPRE con LF: en Windows core.autocrlf=true los
# convertiria a CRLF al hacer checkout y el contenedor fallaria al arrancar
# con "no such file or directory" en el shebang.
*.sh text eol=lf

# index.php ya está versionado con CRLF; conservarlo sin reformatear el archivo.
/index.php -text
