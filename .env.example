# Configuración de Base de Datos
DB_HOST=localhost
DB_PUERTO=3306
DB_NOMBRE=smash_code
DB_USUARIO=root
DB_CLAVE=tu_contraseña_aqui

# Configuración de Servidor de Correos (SMTP)
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=tu_correo@ejemplo.com
SMTP_PASS=tu_contraseña_smtp

# Configuración de Seguridad
JWT_SECRET=genera_un_secreto_seguro_de_32_caracteres_o_mas
# true en despliegues servidos exclusivamente por HTTPS; false en localhost HTTP.
SESSION_COOKIE_SECURE=false
# IPs exactas de proxies de confianza, separadas por coma (opcional).
TRUSTED_PROXIES=
# false permite probar registro local sin intentar enviar correo.
MAIL_ENABLED=true

# Api de gemini para integrar IA en algunos procesos
GEMINI_API_KEY=tu_clave_secreta_aqui

# Inicio de sesión con Google (OAuth 2.0)
# Se obtienen en Google Cloud Console > APIs y servicios > Credenciales >
# ID de cliente de OAuth 2.0 (tipo "Aplicación web").
# GOOGLE_REDIRECT_URI debe coincidir EXACTAMENTE con el URI de redirección
# autorizado que registraste en la consola de Google.
GOOGLE_CLIENT_ID=tu_client_id_aqui.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret_aqui
GOOGLE_REDIRECT_URI=http://localhost/smashcode/login/google/callback
