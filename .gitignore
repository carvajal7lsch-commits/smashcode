# SmashCode .gitignore

# Ignorar archivos de configuración sensibles
.env
/.local/

# Ignorar dependencias de Composer (es buena práctica que cada entorno corra composer install)
/vendor/

# Ignorar archivos temporales y logs de Apache/PHP local
*.log
.tempmediaStorage/
/artifacts/
/scratch/
.gemini/

# Audios e imágenes subidos desde el panel (en Docker viven en un volumen)
/assets/uploads/

# Archivos del sistema operativo
Thumbs.db
Desktop.ini
.DS_Store

# Configuraciones del IDE
.vscode/

